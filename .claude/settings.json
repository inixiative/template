{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/bashMainCheckoutGuard.ts\"",
            "timeout": 10,
            "statusMessage": "worktrees: did this session's cwd drift back to the main checkout?"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/bashMainCheckoutGuard.ts\"",
            "timeout": 10,
            "statusMessage": "worktrees: recording which checkout this session started in"
          }
        ]
      }
    ]
  }
}
