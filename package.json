{
  "name": "template",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "postinstall": "bash ./scripts/postinstall.sh",
    "init": "NODE_ENV=development bun --env-file=.env.init init/index.tsx",
    "init:agent": "NODE_ENV=development bun --env-file=.env.init init/agent.ts",
    "setup": "./scripts/setup/setup.sh",
    "setup:playwright-mcp": "./scripts/setup/playwright-mcp.sh",
    "sync-env": "./scripts/setup/sync-env.sh",
    "with": "./scripts/deployment/with-env.sh",
    "local": "./scripts/local.sh",
    "local:db": "docker-compose up -d --wait",
    "start:api": "bun --cwd apps/api start",
    "start:worker": "bun --cwd apps/api start:worker",
    "start:web": "bun --cwd apps/web preview",
    "start:db": "docker-compose up -d --wait",
    "stop:db": "docker-compose down",
    "reset:db": "docker-compose down && docker-compose up -d --wait && bun run db:push && bun run db:seed --prime",
    "build": "bun run '--filter=*' build",
    "pretest": "bun run with test api bun run --cwd packages/db db:push:force",
    "test": "bun run --cwd packages/permissions test && bun run --cwd packages/db test && bun run --cwd packages/email test && bun run --cwd apps/api test",
    "test:lint": "__TEST_REDIRECT__=1 bun test scripts/lint/tests",
    "test:init": "bash init/tests/with-init-env.sh env NODE_ENV=test bun test init/",
    "test:fe": "bun run generate:sdk && bun run generate:frontend && bun run --filter=@template/shared test && bun run --cwd packages/ui test && __TEST_REDIRECT__=1 NODE_ENV=test bun test --concurrency=1 tests/frontend",
    "typecheck": "bun run --sequential --no-exit-on-error '--filter=*' typecheck",
    "typecheck:fe": "bun run generate:frontend && bun run --cwd apps/web typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/superadmin typecheck",
    "tsc": "bun run typecheck",
    "db:generate": "bun run --filter=@template/db db:generate",
    "db:push": "bun run --filter=@template/db db:push",
    "db:push:dev": "./scripts/db/push-dev.sh",
    "db:push:force": "bun run --filter=@template/db db:push:force",
    "db:migrate": "bun run --filter=@template/db db:migrate",
    "db:deploy": "bun run --filter=@template/db db:deploy",
    "db:baseline": "bun run --filter=@template/db db:baseline",
    "db:studio": "bun run --filter=@template/db db:studio",
    "db:seed": "bun run --filter=api db:seed",
    "db:truncate:webhooks": "bun run with local api bun run --filter=@template/db db:truncate:webhooks",
    "worktree:create": "./scripts/worktree/create.sh",
    "worktree:destroy": "./scripts/worktree/destroy.sh",
    "worktree:list": "./scripts/worktree/list.sh",
    "worktree:ports": "./scripts/worktree/ports.sh",
    "db:dump": "./scripts/db/dump.sh",
    "db:restore": "./scripts/db/restore.sh",
    "db:clone": "./scripts/db/clone.sh",
    "generate:frontend": "bun --cwd apps/web generate:routes && bun --cwd apps/admin generate:routes && bun --cwd apps/superadmin generate:routes && bun --cwd packages/ui generate:icons",
    "generate:sdk": "bun run with ${SDK_ENVIRONMENT:-local} api bash ./scripts/generate-sdk.sh",
    "deploy": "./scripts/deployment/deploy.sh",
    "check:all": "bun run check:setup && bun run lint && bun run typecheck && bun run test && bun run test:fe && bun run build && bash scripts/ci/run-ci-rules.sh",
    "check": "inixiative-config bounded -- bun run check:all",
    "cleanup-scan:record": "./scripts/cleanup-scan/record.sh",
    "check:setup": "bun run generate:frontend && bun run db:generate && bun run generate:sdk",
    "lint": "biome check . && bun run lint:postBiome",
    "lint:postBiome": "./scripts/lint/run-post-biome-checks.sh",
    "lint:imports": "./scripts/lint/check-import-aliases.sh",
    "lint:generated": "./scripts/lint/check-generated-files.sh",
    "lint:fix": "biome check --write . && bun run lint:postBiome",
    "format": "biome format --write .",
    "docs:toc": "bun run scripts/docs/regenToc.ts",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; if [ -x \"$root/node_modules/.bin/lefthook\" ]; then (cd \"$root\" && ./node_modules/.bin/lefthook install); fi; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@iconify-json/lucide": "^1.2.160",
    "@iconify-json/simple-icons": "^1.2.104",
    "@iconify/utils": "^3.1.7",
    "@inixiative/atlas": "^0.5.1",
    "@inixiative/config": "^0.5.256",
    "@lightpanda/browser": "^1.6.0",
    "@mendable/firecrawl-js": "^4.54.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-generator": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/bun": "1.4.4",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "enhanced-resolve": "^5.27.0",
    "lefthook": "2.1.9",
    "tailwindcss": "^4.3.5",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "resolutions": {
    "@hono/node-server": "1.19.13",
    "defu": "6.1.7",
    "effect": "3.22.1",
    "hono": "4.13.22",
    "ioredis": "5.11.1",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "postcss": "8.5.33",
    "protobufjs": "7.6.3",
    "shell-quote": "1.8.4",
    "uuid": "14.0.0"
  },
  "dependencies": {
    "@inixiative/json-rules": "^4.8.0",
    "@inixiative/vcr": "^0.1.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lodash-es": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
