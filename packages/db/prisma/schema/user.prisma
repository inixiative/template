// ============================================================================
// USER
// ============================================================================

model User {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  sourceEntitlements   Entitlement[]   @relation("EntitlementSource")
  targetRuleReferences RuleReference[] @relation("RuleReferenceTarget")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  // The tenant's own additions to the permission schema for the records under it.
  // Shape: Record<Resource, Record<Action, ActionRule>> ('db:Contact' → read → rule). check() ORs each
  // rule with the schema's for that resource and action. Null = schema-only.
  tenantPermissionRules Json?

  email         String  @unique
  emailVerified Boolean @default(false)
  name          String?
  displayName   String?
  image         String?

  // Stamped on sign-in by jwtHandoffPlugin when it issues the JWT. Operational, not
  // versioned — see registries/noopFields.
  lastLoginAt DateTime?
  // Every person JWT carries it as `ver`; incrementing it signs the user out everywhere.
  jwtVersion  Int       @default(0)
  // Kept in sync inside transactions whenever TOTP or Passkeys change.
  twoFactorEnabled Boolean @default(false)

  // Platform-level role (for superadmin access)
  platformRole PlatformRole @default(user)

  // Relations
  accounts                        Account[]
  sessions                        Session[]
  twoFactor                       TwoFactor?
  passkeys                        Passkey[]
  organizationUsers               OrganizationUser[]
  spaceUsers                      SpaceUser[]
  tokens                          Token[]
  cronJobsCreated                 CronJob[]
  webhookSubscriptions            WebhookSubscription[]
  integrations                    Integration[]
  projects                        Project[]
  contacts                        Contact[]
  tagAttachments                  TagAttachment[]
  tags                            Tag[]
  tagCategories                   TagCategory[]
  inquiriesSent                   Inquiry[]              @relation("InquirySource")
  inquiriesReceived               Inquiry[]              @relation("InquiryTarget")
  customerRelationshipsAsProvider CustomerRelationship[] @relation("CustomerRelationshipAsProvider")
  customerRelationshipsAsCustomer CustomerRelationship[] @relation("CustomerRelationshipAsCustomer")
  auditLogsAsActor                AuditLog[]             @relation("AuditLogActorUser")
  auditLogsAsSpoofActor           AuditLog[]             @relation("AuditLogActorSpoofUser")
  auditLogsAsSubject              AuditLog[]             @relation("AuditLogSubjectUser")
  auditLogsAsContextUser          AuditLog[]             @relation("AuditLogContextUser")
  communicationsSent              CommunicationLog[]     @relation("CommunicationSenderUser")
  communicationsReceived          CommunicationLog[]     @relation("CommunicationRecipientUser")
  segments                        Segment[]
  flows                           Flow[]
  settings                        Setting[]
  artifacts                       Artifact[]             @relation("ArtifactOwnerUser")
  granteeArtifactPermissions      ArtifactPermission[]   @relation("ArtifactPermissionGranteeUser")
  resourceBindings                ResourceBinding[]      @relation("ResourceBindingUser")

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  emailTemplates  EmailTemplate[]
  emailComponents EmailComponent[]
}

enum PlatformRole {
  user
  superadmin
}

enum Role {
  owner
  admin
  member
  viewer
}
