model Artifact {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kind   ArtifactKind
  name   String
  access ArtifactAccess @default(private)

  ownerModel     ArtifactOwnerModel
  userId         String?            @db.VarChar(36)
  organizationId String?            @db.VarChar(36)
  spaceId        String?            @db.VarChar(36)

  user             User?             @relation("ArtifactOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation("ArtifactOwnerOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationUser OrganizationUser? @relation("ArtifactOwnerOrganizationUser", fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  space            Space?            @relation("ArtifactOwnerSpace", fields: [organizationId, spaceId], references: [organizationId, id], onDelete: Cascade)
  spaceUser        SpaceUser?        @relation("ArtifactOwnerSpaceUser", fields: [organizationId, spaceId, userId], references: [organizationId, spaceId, userId], onDelete: Cascade)

  file        File?
  bindings    ResourceBinding[]
  permissions ArtifactPermission[]
  placements  ArtifactPlacement[] @relation("ArtifactPlacementArtifact")
  contents    ArtifactPlacement[] @relation("ArtifactPlacementContainer")

  /// @permissions(down: [ancestorArtifact])
  ancestors   ArtifactAncestor[] @relation("ArtifactAncestorDescendant")
  descendants ArtifactAncestor[] @relation("ArtifactAncestorAncestor")

  /// @permissions(down: [permission.granteeUser, permission.granteeOrganization, permission.granteeSpace.organization, permission.granteeOrganizationUser.user, permission.granteeOrganizationUser.organization, permission.granteeSpaceUser.user, permission.granteeSpaceUser.space.organization, permission.granteeCustomerRelationship.customerUser, permission.granteeCustomerRelationship.customerOrganization, permission.granteeCustomerRelationship.customerSpace.organization])
  effectivePermissions ArtifactEffectivePermission[]

  auditLogs AuditLog[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@index([ownerModel])
  @@index([userId])
  @@index([organizationId])
  @@index([spaceId])
  @@index([kind])
}

model ArtifactAncestor {
  id                 String  @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  artifactId         String  @db.VarChar(36)
  ancestorArtifactId String  @db.VarChar(36)
  inherits           Boolean
  inheritsAccess     Boolean
  depth              Int

  artifact         Artifact @relation("ArtifactAncestorDescendant", fields: [artifactId], references: [id], onDelete: Cascade)
  ancestorArtifact Artifact @relation("ArtifactAncestorAncestor", fields: [ancestorArtifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, ancestorArtifactId], map: "ArtifactAncestor_pair_key")
  @@index([ancestorArtifactId, inherits])
  @@index([ancestorArtifactId, inheritsAccess])
}

model ArtifactEffectivePermission {
  id           String @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  artifactId   String @db.VarChar(36)
  permissionId String @db.VarChar(36)

  artifact   Artifact           @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  permission ArtifactPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([artifactId, permissionId], map: "ArtifactEffectivePermission_pair_key")
  @@index([permissionId])
}

model ArtifactPlacement {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ownerModel     ArtifactOwnerModel
  userId         String?            @db.VarChar(36)
  organizationId String?            @db.VarChar(36)
  spaceId        String?            @db.VarChar(36)

  user             User?             @relation("ArtifactPlacementOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation("ArtifactPlacementOwnerOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationUser OrganizationUser? @relation("ArtifactPlacementOwnerOrganizationUser", fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  space            Space?            @relation("ArtifactPlacementOwnerSpace", fields: [organizationId, spaceId], references: [organizationId, id], onDelete: Cascade)
  spaceUser        SpaceUser?        @relation("ArtifactPlacementOwnerSpaceUser", fields: [organizationId, spaceId, userId], references: [organizationId, spaceId, userId], onDelete: Cascade)

  containerArtifactId String?   @db.VarChar(36)
  artifactId          String    @db.VarChar(36)
  containerArtifact   Artifact? @relation("ArtifactPlacementContainer", fields: [containerArtifactId], references: [id], onDelete: Cascade)
  artifact            Artifact  @relation("ArtifactPlacementArtifact", fields: [artifactId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  @@unique([containerArtifactId, artifactId], where: raw("\"deletedAt\" IS NULL"), map: "ArtifactPlacement_edge_key")
  @@unique([artifactId, userId], where: raw("\"containerArtifactId\" IS NULL AND \"ownerModel\" = 'User' AND \"deletedAt\" IS NULL"), map: "ArtifactPlacement_root_user_key")
  @@unique([artifactId, organizationId], where: raw("\"containerArtifactId\" IS NULL AND \"ownerModel\" = 'Organization' AND \"deletedAt\" IS NULL"), map: "ArtifactPlacement_root_organization_key")
  @@unique([artifactId, spaceId], where: raw("\"containerArtifactId\" IS NULL AND \"ownerModel\" = 'Space' AND \"deletedAt\" IS NULL"), map: "ArtifactPlacement_root_space_key")
  @@unique([artifactId, organizationId, userId], where: raw("\"containerArtifactId\" IS NULL AND \"ownerModel\" = 'OrganizationUser' AND \"deletedAt\" IS NULL"), map: "ArtifactPlacement_root_organization_user_key")
  @@unique([artifactId, spaceId, userId], where: raw("\"containerArtifactId\" IS NULL AND \"ownerModel\" = 'SpaceUser' AND \"deletedAt\" IS NULL"), map: "ArtifactPlacement_root_space_user_key")
  @@index([ownerModel])
  @@index([userId])
  @@index([organizationId])
  @@index([spaceId])
  @@index([containerArtifactId])
  @@index([artifactId])
}

model ArtifactPermission {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  artifactId String   @db.VarChar(36)
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  granteeModel                  ArtifactPermissionGranteeModel
  granteeUserId                 String?                        @db.VarChar(36)
  granteeOrganizationId         String?                        @db.VarChar(36)
  granteeSpaceId                String?                        @db.VarChar(36)
  granteeCustomerRelationshipId String?                        @db.VarChar(36)

  granteeUser                 User?                 @relation("ArtifactPermissionGranteeUser", fields: [granteeUserId], references: [id], onDelete: Cascade)
  granteeOrganization         Organization?         @relation("ArtifactPermissionGranteeOrganization", fields: [granteeOrganizationId], references: [id], onDelete: Cascade)
  granteeSpace                Space?                @relation("ArtifactPermissionGranteeSpace", fields: [granteeSpaceId], references: [id], onDelete: Cascade)
  granteeOrganizationUser     OrganizationUser?     @relation("ArtifactPermissionGranteeOrganizationUser", fields: [granteeOrganizationId, granteeUserId], references: [organizationId, userId], onDelete: Cascade)
  granteeSpaceUser            SpaceUser?            @relation("ArtifactPermissionGranteeSpaceUser", fields: [granteeOrganizationId, granteeSpaceId, granteeUserId], references: [organizationId, spaceId, userId], onDelete: Cascade)
  granteeCustomerRelationship CustomerRelationship? @relation("ArtifactPermissionGranteeCustomerRelationship", fields: [granteeCustomerRelationshipId], references: [id], onDelete: Cascade)

  role             Role
  expiresAt        DateTime?
  fromVersion      Int       @default(1)
  preserveOnRevoke Boolean   @default(false)

  effectiveOn ArtifactEffectivePermission[]
  auditLogs   AuditLog[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@unique([artifactId, granteeUserId], where: raw("\"granteeModel\" = 'User' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_user_key")
  @@unique([artifactId, granteeOrganizationId], where: raw("\"granteeModel\" = 'Organization' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_organization_key")
  @@unique([artifactId, granteeSpaceId], where: raw("\"granteeModel\" = 'Space' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_space_key")
  @@unique([artifactId, granteeOrganizationId, granteeUserId], where: raw("\"granteeModel\" = 'OrganizationUser' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_organization_user_key")
  @@unique([artifactId, granteeSpaceId, granteeUserId], where: raw("\"granteeModel\" = 'SpaceUser' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_space_user_key")
  @@unique([artifactId, granteeCustomerRelationshipId], where: raw("\"granteeModel\" = 'CustomerRelationship' AND \"deletedAt\" IS NULL"), map: "ArtifactPermission_customer_relationship_key")
  @@index([artifactId])
  @@index([granteeModel, granteeUserId])
  @@index([granteeModel, granteeOrganizationId])
  @@index([granteeModel, granteeSpaceId])
  @@index([granteeModel, granteeCustomerRelationshipId])
}

enum ArtifactKind {
  file
  folder

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific kinds below
  // ==========================================================================
}

enum ArtifactAccess {
  inherit
  public
  tenant
  private
}

enum ArtifactOwnerModel {
  User
  OrganizationUser
  Organization
  Space
  SpaceUser
}

enum ArtifactPermissionGranteeModel {
  User
  Organization
  Space
  OrganizationUser
  SpaceUser
  CustomerRelationship
}
