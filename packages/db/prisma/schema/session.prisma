/// BetterAuth's default Session schema. Session records live in Redis (secondaryStorage); this table is unused.
model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@index([userId])
}
