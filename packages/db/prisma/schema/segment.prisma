// ============================================================================
// SEGMENT - A named set of a provider's customer references
// ============================================================================
// Owner is false-polymorphic: User | Organization | Space (one FK populated to
// match `ownerModel`, enforced by the falsePolymorphism hook + registry entry).
// The owner is the PROVIDER whose customers are segmented: a member is a
// CustomerRef whose provider is this owner, so the owner axis is coupled to
// CustomerRef.providerModel. A branch of the owner axis with no provider
// branch on CustomerRef (User and Organization today) can own a segment but
// has no customer references to select from — it lights up when CustomerRef
// gains that provider FK.
//
// `dynamic` segments carry `conditions`, a json-rules tree over the segment
// lens rooted at CustomerRef, and their membership is recomputed by the
// reconcile jobs. `static` segments carry no conditions and only manual
// members. Both kinds accept manual members, which reconcile never evicts.
//
// The reconcile-pause triple freezes a dynamic segment whose rule cannot
// produce a correct answer (a reference loop, a rule naming a segment that is
// gone, a rule reading the referenced segment from a bind, or an evaluation
// error). A paused segment is skipped by the sweep and treated as static by
// everyone that references it.

model Segment {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Owner — false polymorphism, exactly one FK matches the discriminator.
  ownerModel     SegmentOwnerModel
  userId         String?           @db.VarChar(36)
  organizationId String?           @db.VarChar(36)
  spaceId        String?           @db.VarChar(36)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space?        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        SegmentType @default(static)

  // json-rules Condition over the segment lens (apps/api/src/modules/segment/lib/segmentLens.ts).
  // Null for static segments. Validated, normalized and reference-checked by the
  // segmentConditions hook on every write.
  conditions       Json?
  conditionsPrompt String?

  reconcilePausedAt     DateTime?
  reconcilePausedReason SegmentReconcilePauseReason?
  reconcilePausedDetail String?

  members   SegmentMember[]
  auditLogs AuditLog[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  // Per-owner uniqueness on name — partial uniques (see Contact for rationale).
  // Each partial doubles as that owner's lookup index.
  @@unique([userId, name], where: { userId: { not: null } })
  @@unique([organizationId, name], where: { organizationId: { not: null } })
  @@unique([spaceId, name], where: { spaceId: { not: null } })
  @@index([ownerModel])
  @@index([type])
}

enum SegmentOwnerModel {
  User
  Organization
  Space
}

enum SegmentType {
  static
  dynamic
}

enum SegmentReconcilePauseReason {
  cycle
  danglingReference
  dynamicReference
  evaluationError
}
