// ============================================================================
// EMAIL TEMPLATE
// ============================================================================
// Email templates with MJML content that can reference EmailComponents via {{component:slug}}.
// Supports polymorphic ownership: default (all tenants), admin (platform), Organization (tenant-branded)

model EmailTemplate {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name   String // "OTP Verification"
  slug   String // "otp"
  locale String            @default("en")
  kind   CommunicationKind @default(activity)

  subject String // "Your verification code: {{code}}"
  mjml    String @db.Text // Full MJML with {{component:slug}} and {{variable.*}} placeholders

  // Pre-computed component refs (populated on save)
  componentRefs         String[] // Slugs of nested {{component:slug}} references
  degradedComponentRefs String[] // Missing component slugs when rendering this row transitively, honoring slot overrides; not necessarily in componentRefs; stamped on write by the versioning hook, on ancestors by the recomputeEmailDependents job, and by the send-path guard

  // The authoring lenses, declared on the slug's default-tier row and inherited by every tenant row.
  // One lens per slot, each built from the projection by choosing an entry point and relations:
  // { recipient?: ModelNarrowing, sender?: ModelNarrowing, data?: { model?, narrowing? } }.
  // data with no entry point is the unknown bag (addressable at any depth). Null = engine defaults.
  lens Json?

  // Owner (false polymorphism - default/admin have no FK)
  ownerModel     EmailOwnerModel @default(default)
  organizationId String?         @db.VarChar(36)
  spaceId        String?         @db.VarChar(36)
  userId         String?         @db.VarChar(36)

  // For org-owned: should spaces inherit this template?
  inheritToSpaces Boolean @default(true)

  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space             Space?             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  communicationLogs CommunicationLog[]
  ruleReferences    RuleReference[]

  // Per-owner uniqueness — one partial unique per ownerModel branch (see EmailComponent for the
  // tier rationale). The uniques are partial on tier only, never on deletedAt: a natural key holds
  // exactly one row, live or tombstoned. Delete tombstones that row and re-saving the key revives it
  // in place with the same id (saveScopedRow), so a second tombstone for a key cannot exist.
  @@unique([slug, locale, ownerModel], where: raw("\"ownerModel\" IN ('default', 'admin')"), map: "EmailTemplate_slug_locale_platform_key")
  @@unique([slug, locale, organizationId], where: raw("\"ownerModel\" = 'Organization'"), map: "EmailTemplate_slug_locale_organization_key")
  @@unique([slug, locale, spaceId], where: raw("\"ownerModel\" = 'Space'"), map: "EmailTemplate_slug_locale_space_key")
  @@unique([slug, locale, userId], where: raw("\"ownerModel\" = 'User'"), map: "EmailTemplate_slug_locale_user_key")
  @@unique([slug, locale, organizationId, userId], where: raw("\"ownerModel\" = 'OrganizationUser'"), map: "EmailTemplate_slug_locale_orguser_key")
  @@unique([slug, locale, spaceId, userId], where: raw("\"ownerModel\" = 'SpaceUser'"), map: "EmailTemplate_slug_locale_spaceuser_key")
  @@index([kind])
  @@index([ownerModel])
  @@index([organizationId])
  @@index([userId])
  @@index([componentRefs(ops: ArrayOps)], type: Gin)
}

