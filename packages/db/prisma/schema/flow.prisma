// ============================================================================
// FLOW - One user's run through a flow definition (apps/api/src/modules/flow/definitions)
// ============================================================================

model Flow {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flowKey        FlowKey
  params         Json      @default("{}")
  returnUrl      String
  currentStep    Int       @default(0)
  completedSteps Json      @default("[]")
  completedAt    DateTime?
  canceledAt     DateTime?

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@index([userId])
}

enum FlowKey {
  setUpOrganization
}
