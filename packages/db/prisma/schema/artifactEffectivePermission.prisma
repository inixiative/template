model ArtifactEffectivePermission {
  id                   String @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  artifactId           String @db.VarChar(36)
  artifactPermissionId String @db.VarChar(36)

  artifact           Artifact           @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  artifactPermission ArtifactPermission @relation(fields: [artifactPermissionId], references: [id], onDelete: Cascade)

  @@unique([artifactId, artifactPermissionId], map: "ArtifactEffectivePermission_pair_key")
  @@index([artifactPermissionId])
}
