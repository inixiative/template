// ============================================================================
// SPACE - Flexible container within an organization
// ============================================================================
// Examples of what a Space might represent:
// - Initiative platform: a vertical/product (e.g., Livestock, Real Estate)
// - SaaS platform: a project, workspace, or environment
// - Marketplace: a storefront or seller account

model Space {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  sourceEntitlements Entitlement[] @relation("EntitlementSource")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  // The tenant's own additions to the permission schema for the records under it.
  // Shape: Record<Resource, Record<Action, ActionRule>> ('db:contact' → read → rule). check() ORs each
  // rule with the schema's for that resource and action. Null = schema-only.
  tenantPermissionRules Json?

  name String
  slug String

  // White-label/theming (optional)
  logoUrl      String?
  primaryColor String?

  // Parent organization (required - Spaces must be owned by Orgs)
  organizationId String       @db.VarChar(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  spaceUsers                      SpaceUser[]
  tokens                          Token[]
  webhookSubscriptions            WebhookSubscription[]
  integrations                    Integration[]
  projects                        Project[]
  contacts                        Contact[]
  tagAttachments                  TagAttachment[]
  tags                            Tag[]
  tagCategories                   TagCategory[]
  emailComponents                 EmailComponent[]
  emailTemplates                  EmailTemplate[]
  targetRuleReferences            RuleReference[]        @relation("RuleReferenceTarget")
  customerRelationshipsAsProvider CustomerRelationship[] @relation("CustomerRelationshipAsProvider")
  customerRelationshipsAsCustomer CustomerRelationship[] @relation("CustomerRelationshipAsCustomer")
  inquiriesSent                   Inquiry[]              @relation("InquirySource")
  inquiriesReceived               Inquiry[]              @relation("InquiryTarget")
  auditLogsAsContext              AuditLog[]             @relation("AuditLogContextSpace")
  auditLogsAsSubject              AuditLog[]             @relation("AuditLogSubjectSpace")
  communicationsSent              CommunicationLog[]     @relation("CommunicationSenderSpace")
  segments                        Segment[]
  settings                        Setting[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  ownedArtifacts   Artifact[]           @relation("ArtifactOwnerSpace")
  artifactGrants   ArtifactPermission[] @relation("ArtifactPermissionGranteeSpace")
  resourceBindings ResourceBinding[] @relation("ResourceBindingSpace")

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([slug])
}
