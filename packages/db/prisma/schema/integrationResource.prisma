// ============================================================================
// INTEGRATION RESOURCE - One thing in the external system an integration reaches
// ============================================================================
// A channel, a repository, a model: the provider's own resource, named by `kind` and the provider's
// `externalId`. Soft-deleted with its integration and revived with it, so the entitlements anchored
// at it and the rules naming it are degraded (sourceDeletedAt, targetDeletedAt), never left
// pointing at a live row under a dead integration. Registering a removed resource again revives it
// (the unique holds tombstones too, so `upsert` finds it), and the cascade revives what died with
// it. `status` says whether we listen to it: `tracked`, `missing` (the
// provider does not show it, now or yet) or `untracked` (the owner stopped caring: kept with its
// grants, out of every list and flow, and never brought back by a sync).

model IntegrationResource {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  sourceEntitlements   Entitlement[]   @relation("EntitlementSource")
  targetRuleReferences RuleReference[] @relation("RuleReferenceTarget")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  name       String
  kind       String
  externalId String
  metadata   Json
  status     IntegrationResourceStatus @default(tracked)

  integrationId String      @db.VarChar(36)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  projectIntegrationResources ProjectIntegrationResource[]

  auditLogsAsSubject AuditLog[] @relation("AuditLogSubjectIntegrationResource")

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@unique([integrationId, kind, externalId], map: "IntegrationResource_integration_kind_externalId_key")
  @@index([integrationId])
}

enum IntegrationResourceStatus {
  tracked
  missing
  untracked
}
