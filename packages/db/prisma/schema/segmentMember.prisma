// ============================================================================
// SEGMENT MEMBER - One customer relationship's membership in one segment
// ============================================================================
// Append/delete lifecycle, no soft delete: a membership either holds or it
// does not. Rows are written only by the reconcile jobs, which diff the
// segment's rule against the live set. The member's customer relationship must
// belong to the segment's owner as its provider (segmentMemberOwner hook).

model SegmentMember {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  sourceEntitlements   Entitlement[]   @relation("EntitlementSource")
  targetRuleReferences RuleReference[] @relation("RuleReferenceTarget")
  createdAt            DateTime        @default(now())

  segmentId String  @db.VarChar(36)
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  customerRelationshipId String      @db.VarChar(36)
  customerRelationship   CustomerRelationship @relation(fields: [customerRelationshipId], references: [id], onDelete: Cascade)

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@unique([segmentId, customerRelationshipId])
  @@index([customerRelationshipId])
}
