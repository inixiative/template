// ============================================================================
// SEGMENT MEMBER - One customer reference's membership in one segment
// ============================================================================
// Append/delete lifecycle, no soft delete: a membership either holds or it
// does not. Rows are written only by the reconcile jobs, which diff the
// segment's rule against the live set. The member's customer reference must
// belong to the segment's owner as its provider (segmentMemberOwner hook).

model SegmentMember {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())

  segmentId String  @db.VarChar(36)
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  customerRefId String      @db.VarChar(36)
  customerRef   CustomerRef @relation(fields: [customerRefId], references: [id], onDelete: Cascade)

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  @@unique([segmentId, customerRefId])
  @@index([customerRefId])
}
