// ============================================================================
// INTEGRATION RECORD - One record's standing in one integration
// ============================================================================
// Record is false-polymorphic over WebhookModel: `recordModel` names the record's
// model and exactly one typed FK is set to match it
// (PolymorphismRegistry.IntegrationRecord). The only standing today is
// poisoned: the integration rejected this record terminally while its
// subscription kept delivering other records, so sendWebhook skips it.
// Nothing clears poisonedAt yet. Soft-deleted with its integration and its
// record, and revived with them.

model IntegrationRecord {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  integrationId String      @db.VarChar(36)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Record — false polymorphism, exactly one FK matches the discriminator.
  recordModel                  WebhookModel
  recordCustomerRelationshipId String?      @db.VarChar(36)
  recordArtifactId             String?      @db.VarChar(36)

  recordCustomerRelationship CustomerRelationship? @relation(fields: [recordCustomerRelationshipId], references: [id], onDelete: Cascade)
  recordArtifact             Artifact?             @relation(fields: [recordArtifactId], references: [id], onDelete: Cascade)

  poisonedAt     DateTime?
  poisonedReason String?

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  // Per-record uniqueness, one composite per record column (see Contact): plain, so NULLS DISTINCT
  // leaves the other arms unconstrained, tombstones keep their key and `upsert` revives them. Each
  // doubles as the lookup index for that record column.
  @@unique([integrationId, recordCustomerRelationshipId], map: "IntegrationRecord_integration_recordCustomerRelationship_key")
  @@unique([integrationId, recordArtifactId], map: "IntegrationRecord_integration_recordArtifact_key")
  @@index([integrationId])
  @@index([recordCustomerRelationshipId])
  @@index([recordArtifactId])
}
