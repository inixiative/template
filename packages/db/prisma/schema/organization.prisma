// ============================================================================
// ORGANIZATION - Multi-tenant support
// ============================================================================

model Organization {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name String
  slug String @unique

  // Relations
  organizationUsers    OrganizationUser[]
  spaceUsers           SpaceUser[]
  tokens               Token[]
  webhookSubscriptions WebhookSubscription[]
  integrations         Integration[]
  contacts             Contact[]
  tagAttachments       TagAttachment[]
  tags                 Tag[]
  tagCategories        TagCategory[]
  inquiriesSent        Inquiry[]             @relation("InquirySource")
  inquiriesReceived    Inquiry[]             @relation("InquiryTarget")
  emailComponents      EmailComponent[]
  emailTemplates       EmailTemplate[]
  targetRuleReferences RuleReference[] @relation("RuleReferenceTarget")
  spaces               Space[]
  customerRefs         CustomerRef[]         @relation("customerRefs")
  providerRefs         CustomerRef[]         @relation("providerRefs")
  authProviders        AuthProvider[]
  auditLogsAsContext   AuditLog[]            @relation("AuditLogContextOrganization")
  auditLogsAsSubject   AuditLog[]            @relation("AuditLogSubjectOrganization")
  communicationsSent   CommunicationLog[]    @relation("CommunicationSenderOrganization")
  segments             Segment[]

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific fields, relations, indexes below
  // ==========================================================================

  ownedFiles       File[]            @relation("FileOwnerOrganization")
  ownedFolders     Folder[]          @relation("FolderOwnerOrganization")
  fileGrants       FilePermission[]  @relation("FilePermissionGranteeOrganization")
  resourceBindings ResourceBinding[] @relation("ResourceBindingOrganization")
}
