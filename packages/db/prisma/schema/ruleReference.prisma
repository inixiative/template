// ============================================================================
// RULE REFERENCE - the rows a stored rule names, as edges
// ============================================================================
// One row per (owner row → referenced row) edge, recomputed by the ruleReference
// hook in the same transaction as every save of a rule-bearing column
// (registry: apps/api/src/hooks/ruleReference/surfaces.ts). Both ends are
// false-polymorphic (exactly one FK matches each discriminator; config in
// registries/falsePolymorphism.ts) so either end can be included. The owner side
// cascades — an owner's edges die with it. The referenced side does not.
//
// A rule that names a row which is gone has no correct evaluation: `any` matches
// nobody, `none` is vacuously true for everyone. So an edge has to survive its
// target and say so. Two ways a target goes, two signals, both on the edge row:
// a soft delete lands in `referencedDeletedAt`, a purge nulls the typed FK and
// leaves `referencedId` naming the row that went. A reader answers "is this rule
// degraded" from the edge alone — no include of the referenced tables, so the
// read does not change shape when a model becomes referenceable.
//
// Nothing here is computed from anything else. `referencedDeletedAt` is one
// scalar copied across one hop, which can be fresh or stale but never subtly
// wrong; there is no closure, no propagation, and no transitive flag.

model RuleReference {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())

  ownerModel       RuleReferenceOwnerModel
  emailTemplateId  String? @db.VarChar(36)
  emailComponentId String? @db.VarChar(36)

  referencedModel RuleReferenceReferencedModel
  // True poly beside the false: the name, written once and never updated. The typed FK below is the
  // relation, and the database nulls it when the row is purged - this is what still says which row
  // the rule meant. Written from the same value as the FK, so the two agree by construction.
  referencedId    String  @db.VarChar(36)
  tagId           String? @db.VarChar(36)
  organizationId  String? @db.VarChar(36)
  spaceId         String? @db.VarChar(36)

  // Snapshot of the referenced row's deletedAt, maintained by ruleReference:referenced. One scalar
  // copied across one hop, so a reader answers "is this rule degraded" from the edge alone rather
  // than including every referenceable table.
  referencedDeletedAt DateTime?

  emailTemplate  EmailTemplate?  @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)
  emailComponent EmailComponent? @relation(fields: [emailComponentId], references: [id], onDelete: Cascade)
  // No onDelete: purging a referenced row nulls the FK (SetNull) and leaves the edge standing as
  // the record that a rule named something now gone. Cascade would delete the evidence.
  tag            Tag?            @relation(fields: [tagId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  space          Space?          @relation(fields: [spaceId], references: [id])

  // Edge identity. The discriminator is inside the key, so this needs no partial predicate: six
  // partial uniques collapse to one per owner column.
  @@unique([emailTemplateId, referencedModel, referencedId], map: "RuleReference_emailTemplate_referenced_key")
  @@unique([emailComponentId, referencedModel, referencedId], map: "RuleReference_emailComponent_referenced_key")
  @@index([referencedModel, referencedId])
  @@index([emailTemplateId])
  @@index([emailComponentId])
  @@index([tagId])
  @@index([organizationId])
  @@index([spaceId])
}

enum RuleReferenceOwnerModel {
  EmailTemplate
  EmailComponent

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific rule-bearing models below
  // ==========================================================================
}

enum RuleReferenceReferencedModel {
  Tag
  Organization
  Space

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific referenceable models below
  // ==========================================================================
}
