// ============================================================================
// RULE REFERENCE - the rows a stored rule names, as edges
// ============================================================================
// One row per (source row → target row) edge, recomputed by
// syncRuleReferenceEdges (packages/db/src/utils) inside the transaction of every
// save of a rule-bearing column; email calls it from its save path, segments from
// an after-write hook. Both ends are false-polymorphic (exactly one FK matches each
// discriminator; config in registries/falsePolymorphism.ts) so either end can be
// included. The source side cascades — a source's edges die with it. The target
// side does not.
//
// A rule that names a row which is gone has no correct evaluation: `any` matches
// nobody, `none` is vacuously true for everyone. So an edge has to survive its
// target and say so. Two ways a target goes, two signals, both on the edge row:
// a soft delete lands in `targetDeletedAt`, a purge nulls the typed FK and
// leaves `targetId` naming the row that went. A reader answers "is this rule
// degraded" from the edge alone — no include of the target tables, so the
// read does not change shape when a model becomes referenceable.
//
// Nothing here is computed from anything else. `targetDeletedAt` is one
// scalar copied across one hop, which can be fresh or stale but never subtly
// wrong; there is no closure, no propagation, and no transitive flag.

model RuleReference {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())

  sourceModel            RuleReferenceSourceModel
  sourceEmailTemplateId  String? @db.VarChar(36)
  sourceEmailComponentId String? @db.VarChar(36)
  sourceSegmentId        String? @db.VarChar(36)

  targetModel            RuleReferenceTargetModel
  // True poly beside the false: the name, written once and never updated. The typed FK below is the
  // relation, and the database nulls it when the row is purged - this is what still says which row
  // the rule meant. Written from the same value as the FK, so the two agree by construction.
  targetId               String  @db.VarChar(36)
  targetTagId            String? @db.VarChar(36)
  targetOrganizationId   String? @db.VarChar(36)
  targetSpaceId          String? @db.VarChar(36)
  targetSegmentId        String? @db.VarChar(36)

  // Snapshot of the target row's deletedAt, maintained by ruleReference:target. One scalar
  // copied across one hop, so a reader answers "is this rule degraded" from the edge alone rather
  // than including every referenceable table.
  targetDeletedAt DateTime?

  sourceEmailTemplate  EmailTemplate?  @relation("RuleReferenceSource", fields: [sourceEmailTemplateId], references: [id], onDelete: Cascade)
  sourceEmailComponent EmailComponent? @relation("RuleReferenceSource", fields: [sourceEmailComponentId], references: [id], onDelete: Cascade)
  sourceSegment        Segment?        @relation("RuleReferenceSource", fields: [sourceSegmentId], references: [id], onDelete: Cascade)
  // No onDelete: purging a target row nulls the FK (SetNull) and leaves the edge standing as
  // the record that a rule named something now gone. Cascade would delete the evidence.
  targetTag            Tag?            @relation("RuleReferenceTarget", fields: [targetTagId], references: [id])
  targetOrganization   Organization?   @relation("RuleReferenceTarget", fields: [targetOrganizationId], references: [id])
  targetSpace          Space?          @relation("RuleReferenceTarget", fields: [targetSpaceId], references: [id])
  targetSegment        Segment?        @relation("RuleReferenceTarget", fields: [targetSegmentId], references: [id])

  // Edge identity. The discriminator is inside the key, so this needs no partial predicate: one
  // unique per source column.
  @@unique([sourceEmailTemplateId, targetModel, targetId], map: "RuleReference_sourceEmailTemplate_target_key")
  @@unique([sourceEmailComponentId, targetModel, targetId], map: "RuleReference_sourceEmailComponent_target_key")
  @@unique([sourceSegmentId, targetModel, targetId], map: "RuleReference_sourceSegment_target_key")
  @@index([targetModel, targetId])
  @@index([sourceEmailTemplateId])
  @@index([sourceEmailComponentId])
  @@index([sourceSegmentId])
  @@index([targetTagId])
  @@index([targetOrganizationId])
  @@index([targetSpaceId])
  @@index([targetSegmentId])
}

enum RuleReferenceSourceModel {
  EmailTemplate
  EmailComponent
  Segment

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific rule-bearing models below
  // ==========================================================================
}

enum RuleReferenceTargetModel {
  Tag
  Organization
  Space
  Segment

  // ==========================================================================
  // TEMPLATE ABOVE — Add app-specific referenceable models below
  // ==========================================================================
}
