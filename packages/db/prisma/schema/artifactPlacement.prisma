model ArtifactPlacement {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.VarChar(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containerArtifactId String         @db.VarChar(36)
  artifactId          String         @db.VarChar(36)
  access              ArtifactAccess @default(inherit)

  containerArtifact Artifact @relation("ArtifactPlacementContainer", fields: [containerArtifactId], references: [id], onDelete: Cascade)
  artifact          Artifact @relation("ArtifactPlacementArtifact", fields: [artifactId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  @@unique([containerArtifactId, artifactId], map: "ArtifactPlacement_edge_key")
  @@index([containerArtifactId])
  @@index([artifactId])
}
