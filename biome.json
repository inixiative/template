{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": ["@inixiative/config/biome/base.json", "@inixiative/config/biome/react.json"],
  "files": {
    "includes": [
      "!**/.claude",
      "!**/public",
      "!docs/**/*.html",
      "!packages/shared/styles/theme.css",
      "!scripts/ci/rule-violations"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "PascalCase"],
            "requireAscii": true,
            "strictCase": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/**/app/**", "apps/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Relative imports are not allowed. Use #/ for app-local imports or @template/* for package imports."
                  },
                  {
                    "group": ["##/**", "~/**"],
                    "message": "Apps should use #/ for local imports and @template/* for package imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Relative imports are not allowed in packages. Use @template/<pkg>/* imports."
                  },
                  {
                    "group": ["#/**", "##/**", "~/**"],
                    "message": "Packages should use @template/<pkg>/* imports for absolute references."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/**/app/**/index.ts",
        "apps/**/app/**/index.tsx",
        "apps/api/src/**/index.ts",
        "packages/**/src/**/index.ts",
        "packages/**/src/**/index.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/**/app/routes/**",
        "**/app/routes/**",
        "**/tests/mocks/**",
        "project.config.template-internal.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/vite.config.ts",
        "**/postcss.config.mjs",
        "**/app.config.ts",
        "**/prisma.config.ts",
        "**/openapiTs.config.ts",
        ".atlas/config.ts",
        "**/app/ssr.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
